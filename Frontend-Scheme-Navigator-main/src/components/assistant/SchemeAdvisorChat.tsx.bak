        { label: '🏥 ਆਯੁਸ਼ਮਾਨ ਭਾਰਤ ਸਿਹਤ ਕਾਰਡ', query: 'ਆਯੁਸ਼ਮਾਨ ਭਾਰਤ ਕਾਰਡ ਅਤੇ 5 ਲੱਖ ਤੱਕ ਮੁਫ਼ਤ ਇਲਾਜ ਦੀ ਯੋਗਤਾ ਕੀ ਹੈ?' },
        { label: '🐄 ਡੇਅਰੀ ਤੇ ਪਸ਼ੂ ਪਾਲਣ ਸਬਸਿਡੀਆਂ', query: 'ਡੇਅਰੀ ਫਾਰਮਿੰਗ, ਗਾਵਾਂ-ਮੱਝਾਂ ਅਤੇ ਮੱਛੀ ਪਾਲਣ ਲਈ ਸਰਕਾਰੀ ਸਬਸਿਡੀ ਸਕੀਮਾਂ' },
      ];
    }
    if (isHindi) {
      return [
        { label: '🌾 पीएम किसान सम्मान निधि स्टेटस', query: 'मुझे पीएम किसान ₹6,000 सम्मान निधि और अगली किस्त की जानकारी बताइए' },
