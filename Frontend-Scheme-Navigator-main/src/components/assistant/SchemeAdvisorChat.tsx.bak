  'ml-IN': 'ഞാൻ നിങ്ങളുടെ അഭ്യർത്ഥന വിശകലനം ചെയ്യുകയാണ്. നിങ്ങൾക്ക് നേരിട്ട് പദ്ധതികളുടെ പട്ടിക കാണുകയോ യോഗ്യതാ സർവേ പൂർത്തിയാക്കുകയോ ചെയ്യാം.',
  'pa-IN': 'ਮੈਂ ਤੁਹਾਡੀ ਬੇਨਤੀ ਦਾ ਵਿਸ਼ਲੇਸ਼ਣ ਕਰ ਰਿਹਾ ਹਾਂ। ਤੁਸੀਂ ਸਿੱਧਾ ਸਕੀਮਾਂ ਦੀ ਸੂਚੀ ਵੀ ਵੇਖ ਸਕਦੇ ਹੋ ਜਾਂ ਯੋਗਤਾ ਸਰਵੇਖਣ ਪੂਰਾ ਕਰ ਸਕਦੇ ਹੋ।',
  'ur-IN': 'میں آپ کی درخواست کا تجزیہ کر رہا ہوں۔ آپ براہ راست اسکیموں کی فہرست بھی دیکھ سکتے ہیں یا اہلیت کا سروے مکمل کر سکتے ہیں۔',
};

const getLocalizedText = (dict: Record<string, string>, lang: string): string => {
  if (!lang) return dict['en-IN'];
  if (dict[lang]) return dict[lang];
  const prefix = lang.split('-')[0].toLowerCase();
  const foundKey = Object.keys(dict).find((k) => k.toLowerCase().startsWith(prefix));
  return (foundKey && dict[foundKey]) || dict['en-IN'];
};

const getChatPromptsByLang = (langCode: string, profile?: UserProfile | null) => {
  const occ = (profile?.employmentType || (profile as any)?.occupation || '').toLowerCase();
  const isStudent = occ.includes('student') || Boolean(profile?.studentCourse);
  const isFarmer = occ.includes('farmer') || occ.includes('kisan') || occ.includes('kheti');
  const isBusiness = occ.includes('business') || occ.includes('self') || occ.includes('shop') || occ.includes('vendor');
  const isFemale = profile?.gender === 'female';
  const isSenior = (profile?.age || 0) >= 60;
  const isHindi = langCode.startsWith('hi');
  const isBengali = langCode.startsWith('bn');
  const isUrdu = langCode.startsWith('ur');
  const isPunjabi = langCode.startsWith('pa');
  const isOdia = langCode.startsWith('or');

  // 1. Personalized Student Prompts
  if (isStudent) {
    if (isBengali) {
      return [
        { label: '🎓 কলেজ স্কলারশিপ ও অনুদান', query: 'আমার প্রোফাইল অনুযায়ী কলেজ ও উচ্চশিক্ষার জন্য কোন সরকারি স্কলারশিপ রয়েছে?' },
        { label: '💻 ফ্রি স্কিল ট্রেনিং ও ল্যাপটপ', query: 'ছাত্রদের জন্য সরকারি ফ্রি টেকনিক্যাল ট্রেনিং ও স্টাইপেন্ড প্রকল্পের তথ্য দিন' },
        { label: '📚 এডুকেশন লোন ও সুদ সাবসিডি', query: 'কলেজের পড়াশোনার জন্য স্বল্প সুদের শিক্ষা ঋণ ও সরকারি ভর্তুকি' },
        { label: '🏥 আয়ুষ্মান ভারত স্বাস্থ্য কার্ড', query: 'আয়ুষ্মান ভারত কার্ড এবং ৫ লাখ টাকার বিনামূল্যে চিকিৎসার যোগ্যতা কি?' },
        { label: '💼 তরুণদের জন্য স্টার্টআপ অনুদান', query: 'নতুন স্টার্টআপ বা উদ্ভাবনী প্রকল্পের জন্য সরকারি ফান্ডিং ও ইনকিউবেশন প্রকল্প' },
        { label: '📜 প্রতিযোগিতামূলক পরীক্ষার ফ্রি কোচিং', query: 'সরকারি চাকরির পরীক্ষার (UPSC, SSC, Banking) জন্য সরকারি ফ্রি কোচিং প্রকল্প' },
      ];
    }
    if (isUrdu) {
      return [
        { label: '🎓 کالج اسکالرشپ اور وظائف', query: 'میری پروفائل کے مطابق کالج اور اعلیٰ تعلیم کے لیے کون سے سرکاری وظائف دستیاب ہیں؟' },
        { label: '💻 مفت ہنر اور لیپ ٹاپ اسکیم', query: 'طلباء کے لیے مفت تکنیکی تربیت اور وظیفہ پروگراموں کی تفصیلات بتائیں' },
        { label: '📚 رعایتی ایجوکیشن لون', query: 'کالج کی پڑھائی کے لیے کم سود والا تعلیمی قرضہ اور سرکاری سبسڈی' },
        { label: '🏥 آیوشمان بھارت ہیلتھ کارڈ', query: 'آیوشمان بھارت کارڈ اور 5 لاکھ تک مفت علاج کی اہلیت کیا ہے؟' },
        { label: '💼 نوجوانوں کے لیے اسٹارٹ اپ فنڈ', query: 'نئے کاروبار اور اختراعی پروجیکٹس کے لیے سرکاری گرانٹس اور انکیوبیشن' },
        { label: '📜 مسابقتی امتحانات کی مفت کوچنگ', query: 'سرکاری امتحانات (UPSC, SSC, Banking) کی تیاری کے لیے مفت حکومتی کوچنگ' },
      ];
    }
    if (isPunjabi) {
      return [
        { label: '🎓 ਕਾਲਜ ਵਜ਼ੀਫ਼ੇ ਅਤੇ ਸਹਾਇਤਾ', query: 'ਮੇਰੇ ਪ੍ਰੋਫਾਈਲ ਅਨੁਸਾਰ ਕਾਲਜ ਅਤੇ ਉੱਚ ਸਿੱਖਿਆ ਲਈ ਕਿਹੜੀਆਂ ਸਰਕਾਰੀ ਸਕਾਲਰਸ਼ਿਪਾਂ ਹਨ?' },
        { label: '💻 ਮੁਫ਼ਤ ਸਕਿੱਲ ਟਰੇਨਿੰਗ ਤੇ ਲੈਪਟਾਪ', query: 'ਵਿਦਿਆਰਥੀਆਂ ਲਈ ਮੁਫ਼ਤ ਤਕਨੀਕੀ ਸਿਖਲਾਈ ਅਤੇ ਵਜ਼ੀਫ਼ਾ ਪ੍ਰੋਗਰਾਮਾਂ ਦੀ ਜਾਣਕਾਰੀ ਦਿਓ' },
        { label: '📚 ਘੱਟ ਵਿਆਜ ਵਾਲਾ ਐਜੂਕੇਸ਼ਨ ਲੋਨ', query: 'ਕਾਲਜ ਦੀ ਪੜ੍ਹਾਈ ਲਈ ਘੱਟ ਵਿਆਜ \'ਤੇ ਸਿੱਖਿਆ ਕਰਜ਼ਾ ਅਤੇ ਸਰਕਾਰੀ ਸਬਸਿਡੀ' },
        { label: '🏥 ਆਯੁਸ਼ਮਾਨ ਭਾਰਤ ਸਿਹਤ ਕਾਰਡ', query: 'ਆਯੁਸ਼ਮਾਨ ਭਾਰਤ ਕਾਰਡ ਅਤੇ 5 ਲੱਖ ਤੱਕ ਮੁਫ਼ਤ ਇਲਾਜ ਦੀ ਯੋਗਤਾ ਕੀ ਹੈ?' },
        { label: '💼 ਨੌਜਵਾਨਾਂ ਲਈ ਸਟਾਰਟਅੱਪ ਗ੍ਰਾਂਟ', query: 'ਨਵੇਂ ਸਟਾਰਟਅੱਪ ਜਾਂ ਪ੍ਰੋਜੈਕਟ ਲਈ ਸਰਕਾਰੀ ਫੰਡਿੰਗ ਅਤੇ ਇਨਕਿਊਬੇਸ਼ਨ ਸਕੀਮਾਂ' },
        { label: '📜 ਮੁਕਾਬਲੇ ਦੀਆਂ ਪ੍ਰੀਖਿਆਵਾਂ ਦੀ ਮੁਫ਼ਤ ਕੋਚਿੰਗ', query: 'ਸਰਕਾਰੀ ਨੌਕਰੀਆਂ ਦੇ ਇਮਤਿਹਾਨਾਂ (UPSC, SSC, Banking) ਲਈ ਮੁਫ਼ਤ ਕੋਚਿੰਗ ਸਕੀਮ' },
      ];
    }
    if (isHindi) {
      return [
        { label: '🎓 मेरे लिए कॉलेज छात्रवृत्ति', query: 'मेरी प्रोफ़ाइल के अनुसार कॉलेज और उच्च शिक्षा के लिए कौन सी सरकारी स्कॉलरशिप उपलब्ध हैं?' },
        { label: '💻 फ्री स्किल व लैपटॉप योजना', query: 'छात्रों के लिए फ्री तकनीकी प्रशिक्षण, कौशल विकास और लैपटॉप योजना की जानकारी दें' },
        { label: '📚 उच्च शिक्षा लोन ब्याज सब्सिडी', query: 'कॉलेज और डिग्री पढ़ाई के लिए कम ब्याज वाला एजुकेशन लोन और सरकारी सब्सिडी' },
